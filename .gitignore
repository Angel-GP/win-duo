# venv 与安装缓存: setup_env.ps1 建在工作区内, 不入库
.venv/
.tmp/
.pipcache/

__pycache__/
*.pyc

# 用户配置 + 调试产物: 全部收在 diagnostics/ 下, 运行时生成, 不入库
#   diagnostics/config/config.json          用户配置
#   diagnostics/debug/log/win_duo.log       运行日志
#   diagnostics/debug/camera_dump/          冻结帧抓图
diagnostics/
config.json

# 运行产物: 大多能重新生成
smoke_widget.png
smoke_grab.png
smoke_frame.png
*_log.txt
dbg*.txt
*.log

# 本地背景图 (用户自己的壁纸)
desk_bg.png

# 摄像头自检输出的画面
frame_camera_probe.png

# 冻结帧 dump (旧的根级路径; 新路径由上面的 diagnostics/ 覆盖)
camera_dump/

# 着色器对照图 (offscreen_test.py 生成, 每次跑都重画)
offscreen_tilt*.png

# PyInstaller 打包产物: exe 约 94MB, 不该进仓库
# (发布时另外传 release, 或让用户自己跑 scripts/build_exe.py)
build/
dist/
*.spec
